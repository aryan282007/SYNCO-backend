rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if user is accessing their own path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Function to validate file size (e.g. max 5MB)
    function isFileSizeValid(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    // Function to validate image type
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // User Profile Images
    match /users/{userId}/profile/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isFileSizeValid(5) && isImage();
    }

    // User Food Scans
    match /users/{userId}/food/{fileName} {
      allow read, write: if isOwner(userId) && isFileSizeValid(10) && isImage();
    }

    // Doctor Documents
    match /doctors/{doctorId}/documents/{fileName} {
      // Only the doctor (owner) and admins can read/write their documents
      allow read, write: if isOwner(doctorId) && isFileSizeValid(10);
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
