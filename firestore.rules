rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Function to securely check if a user is a participant of a chat.
    // Supports both the legacy `chats/{chatId}` shape and the newer `conversations/{conversationId}` shape.
    function isParticipantInData(data) {
      return data != null && (
        ('participants' in data && request.auth.uid in data.participants) ||
        ('patientId' in data && request.auth.uid == data.patientId) ||
        ('doctorId' in data && request.auth.uid == data.doctorId) ||
        ('userId' in data && request.auth.uid == data.userId)
      );
    }

    function isChatParticipant(chatId) {
      let chatExists = exists(/databases/$(database)/documents/chats/$(chatId));
      let chatData = chatExists ? get(/databases/$(database)/documents/chats/$(chatId)).data : null;

      let bookingExists = exists(/databases/$(database)/documents/bookings/$(chatId));
      let bookingData = bookingExists ? get(/databases/$(database)/documents/bookings/$(chatId)).data : null;

      let conversationExists = exists(/databases/$(database)/documents/conversations/$(chatId));
      let conversationData = conversationExists ? get(/databases/$(database)/documents/conversations/$(chatId)).data : null;

      let inChat = chatExists && isParticipantInData(chatData);
      let inBooking = bookingExists && isParticipantInData(bookingData);
      let inConversation = conversationExists && isParticipantInData(conversationData);

      let inInquiry = chatId.matches('^inquiry_' + request.auth.uid + '_.*') || 
                      chatId.matches('^inquiry_.*_' + request.auth.uid + '$');

      return inChat || inBooking || inConversation || inInquiry;
    }

    // Phase 1 & 3: Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /notifications/{notificationId} {
        allow write: if isAuthenticated();
      }
      
      
      // Allow access to all subcollections (period_logs, symptom_logs, etc)
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // Phase 1 & 3: Doctors collection
    match /doctors/{doctorId} {
      allow read: if true; // Publicly readable profiles
      allow write: if isOwner(doctorId) || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'totalReviews'])
      ); // Allow patients to update aggregate ratings

      // Reviews Subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.patientId;
        allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.patientId;
      }
    }

    // Phase 1 & 3: Bookings collection
    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated() && (
        ('userId' in resource.data && request.auth.uid == resource.data.userId) ||
        ('patientId' in resource.data && request.auth.uid == resource.data.patientId) || 
        ('doctorId' in resource.data && request.auth.uid == resource.data.doctorId) ||
        // Allow creating the booking if the user is the patient
        (request.method == 'create' && request.auth.uid == request.resource.data.patientId)
      );
    }

    // 1-to-1 Real-Time Chat (Firestore-backed conversations)
    match /conversations/{conversationId} {
      allow read, update: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId
      );
      allow create: if request.auth != null && (
        request.auth.uid in request.resource.data.participants ||
        request.auth.uid == request.resource.data.patientId ||
        request.auth.uid == request.resource.data.doctorId
      );

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.patientId ||
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.doctorId
        );

        allow create: if request.auth != null 
          && request.resource.data.senderId == request.auth.uid
          && (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
            request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.patientId ||
            request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.doctorId
          );

        allow update: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.patientId ||
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.doctorId
        );
      }
    }

    // Legacy chat engine used by the current app and older seeds.
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && isChatParticipant(chatId);
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && isChatParticipant(chatId);
      }
    }

    // Phase 1 & 3: Whisper Room posts
    match /whisper_posts/{postId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.authorId ||
        (request.resource.data.isAnonymous == true && request.resource.data.authorId == '')
      );
    }

    // Phase 2: UGC Moderation - Reported Posts
    match /reported_posts/{reportId} {
      // Users can only create a report, not read the queue (that's for admins)
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false; 
    }

    // Phase 2: UGC Moderation - Blocked Users
    match /users/{userId}/blocked_users/{blockedId} {
      // Users can manage their own blocked list
      allow read, write: if isOwner(userId);
    }
    
    // Phase 3: Learn Content (Pink Corner Articles)
    match /articles/{articleId} {
      allow read: if true; // Publicly readable educational articles
      allow write: if false; // Only admin (via Admin SDK/Vercel) can write
    }

    match /learn_content/{docId} {
      allow read: if true;
      allow write: if true; // Temporarily allow anyone to seed
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true; // Temporarily allow anyone to seed
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
