rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can only access their own user profile and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Cascading rules for subcollections (daily_logs, medical_reports, health_summaries)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Bookings collection
    // Patients and Doctors can only access bookings they are a part of
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.doctorId ||
        // Allow creation if the creator is setting themselves as the userId or doctorId
        (request.method == 'create' && (request.auth.uid == request.resource.data.userId || request.auth.uid == request.resource.data.doctorId))
      );
    }
    
    // Conversations and Messages (Old)
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.doctorId ||
        (request.method == 'create' && (request.auth.uid == request.resource.data.userId || request.auth.uid == request.resource.data.doctorId))
      );
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.doctorId
        );
      }
    }

    // Real-Time Chat Engine (New Frontend Standard)
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.doctorId ||
        (request.method == 'create' && (request.auth.uid == request.resource.data.patientId || request.auth.uid == request.resource.data.doctorId))
      );
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.patientId ||
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.doctorId
        );
      }
    }

    // Whisper Room (Anonymous Community)
    match /whisper_posts/{postId} {
      allow read: if request.auth != null; // Anyone logged in can read
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid; // Only logged in users can create their own posts
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid; // Only author can edit/delete
    }

    // Public Content (Articles, FAQs) - Publicly readable without auth
    match /articles/{articleId} {
      allow read: if true;
      allow write: if false; 
    }
    match /Articles/{articleId} {
      allow read: if true;
      allow write: if false; 
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if false;
    }
    match /Faqs/{faqId} {
      allow read: if true;
      allow write: if false;
    }
    match /faq/{faqId} {
      allow read: if true;
      allow write: if false;
    }
    match /learn_content/{docId} {
      allow read: if true;
      allow write: if false; 
    }
  }
}
