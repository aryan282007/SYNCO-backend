rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can only access their own user profile and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow any authenticated user to send notifications to others (e.g. Doctors to Patients)
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null;
      }
      
      // Cascading rules for other subcollections (daily_logs, medical_reports, health_summaries)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId ||
        (request.method == 'create' && (request.auth.uid == request.resource.data.userId || request.auth.uid == request.resource.data.patientId || request.auth.uid == request.resource.data.doctorId))
      );
    }
    
    // Real-Time Chat Engine
    match /chats/{chatId} {
      allow read, write: if request.auth != null; // Frontend standard
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null; // Frontend standard
      }
    }

    // Whisper Room (Anonymous Community)
    match /whisper_posts/{postId} {
      allow read: if request.auth != null; // Anyone logged in can read
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid; // Only logged in users can create their own posts
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid; // Only author can edit/delete
    }

    // Public Content (Articles, FAQs) - Publicly readable without auth
    match /articles/{articleId} {
      allow read: if true;
      allow write: if false; 
    }
    match /Articles/{articleId} {
      allow read: if true;
      allow write: if false; 
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if false;
    }
    match /Faqs/{faqId} {
      allow read: if true;
      allow write: if false;
    }
    match /faq/{faqId} {
      allow read: if true;
      allow write: if false;
    }
    match /learn_content/{docId} {
      allow read: if true;
      allow write: if false; 
    }
  }
}
