rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Phase 1 & 3: Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /notifications/{notificationId} {
        allow write: if isAuthenticated();
      }
      
      
      // Allow access to all subcollections (period_logs, symptom_logs, etc)
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // Phase 1 & 3: Doctors collection
    match /doctors/{doctorId} {
      allow read: if true; // Publicly readable profiles
      allow write: if isOwner(doctorId) || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'totalReviews'])
      ); // Allow patients to update aggregate ratings

      // Reviews Subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.patientId;
        allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.patientId;
      }
    }

    // Phase 1 & 3: Bookings collection
    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.doctorId ||
        // Allow creating the booking if the user is the patient
        (request.method == 'create' && request.auth.uid == request.resource.data.patientId)
      );
    }

    // Real-Time Chat Engine
    match /chats/{chatId} {
      // Allow read/write if the user is in the participants array (fallback to request for create, and old schema)
      allow read, write: if request.auth != null && (
        ('participants' in (resource == null ? request.resource.data : resource.data) && request.auth.uid in (resource == null ? request.resource.data.participants : resource.data.participants)) ||
        ('patientId' in (resource == null ? request.resource.data : resource.data) && request.auth.uid == (resource == null ? request.resource.data.patientId : resource.data.patientId)) ||
        ('doctorId' in (resource == null ? request.resource.data : resource.data) && request.auth.uid == (resource == null ? request.resource.data.doctorId : resource.data.doctorId))
      );
      
      match /messages/{messageId} {
        // Allow read/write to the messages subcollection if they can access the parent chat (support old schema)
        allow read, write: if request.auth != null && (
          ('participants' in get(/databases/$(database)/documents/chats/$(chatId)).data && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
          ('patientId' in get(/databases/$(database)/documents/chats/$(chatId)).data && request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.patientId) ||
          ('doctorId' in get(/databases/$(database)/documents/chats/$(chatId)).data && request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.doctorId)
        );
      }
    }

    // Phase 1 & 3: Whisper Room posts
    match /whisper_posts/{postId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.authorId ||
        (request.resource.data.isAnonymous == true && request.resource.data.authorId == '')
      );
    }

    // Phase 2: UGC Moderation - Reported Posts
    match /reported_posts/{reportId} {
      // Users can only create a report, not read the queue (that's for admins)
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false; 
    }

    // Phase 2: UGC Moderation - Blocked Users
    match /users/{userId}/blocked_users/{blockedId} {
      // Users can manage their own blocked list
      allow read, write: if isOwner(userId);
    }
    
    // Phase 3: Learn Content (Pink Corner Articles)
    match /articles/{articleId} {
      allow read: if true; // Publicly readable educational articles
      allow write: if false; // Only admin (via Admin SDK/Vercel) can write
    }

    match /learn_content/{docId} {
      allow read: if true;
      allow write: if true; // Temporarily allow anyone to seed
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true; // Temporarily allow anyone to seed
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
